/* STACK's operator declarations (stack/maxima/noun_simp.mac, assessment.mac and
   stack_logic.lisp), for a plain Maxima. The STACK-Maxima image has them already. */
nary("nounand", 65)$ nary("nounor", 61)$ prefix("nounnot", 70)$
prefix("#pm#")$ nary("#pm#", 100)$
nary("nouneq", 150)$ nary("nounadd", 100)$ prefix("nounsub", 100)$ nary("nounmul", 120)$
infix("noundiv", 122, 123)$ infix("nounpow", 140, 139)$ prefix("UNARY_RECIP", 100)$
nary("nand", 62)$ nary("nor", 61)$ infix("implies", 59)$ nary("xnor", 58)$ nary("xor", 58)$
